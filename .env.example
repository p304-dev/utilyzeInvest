# --- Anthropic (LLM research calls, with web search) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4096
WEB_SEARCH_MAX_USES=5

# --- Google Sheets (service account) ---
# Path to the service-account key JSON file. The service account must be
# shared as Editor on the target spreadsheet. Each worker reads its own
# tab (vc_research -> Investors, grants -> Grants / Pitches).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
SHEET_ID=

# --- Runner behavior ---
# 250 clears the ~968-row backfill in ~4 biweekly runs while staying well
# inside the 6-hour GitHub Actions job limit. Steady state is far smaller.
BATCH_SIZE=250
CONFIDENCE_MIN=0.65

# Header holding the Investors tab's queue formula. Change here, not in
# code, if the column is ever renamed.
QUEUE_COLUMN=Deadline Formula

# Fetch a row's known Website and extract from that page before paying for
# a web-search call. Set false to always use full research.
FETCH_FIRST=true
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_CHARS=20000

# --- Gmail draft creation (optional, off by default) ---
# Requires domain-wide delegation granted by a Workspace admin for the
# gmail.compose scope. Leave GMAIL_ENABLED=false until that's set up;
# the worker still writes Draft_Subject/Draft_Body to the sheet either way.
GMAIL_ENABLED=false
GMAIL_SENDER=ana.valentino@utilyze.ai

# --- Wix CMS publish (only used by `main.py --publish`) ---
WIX_API_KEY=
WIX_SITE_ID=
WIX_COLLECTION_ID=

# --- Company context injected into prompts (never invent beyond this) ---
UTILYZE_CONTEXT_FILE=config/utilyze_context.md

LOG_LEVEL=INFO
