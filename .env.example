# --- Anthropic (LLM research calls, with web search) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4096
WEB_SEARCH_MAX_USES=5

# --- Google Sheets (service account) ---
# Path to the service-account key JSON file. See README.md for the
# one-time GCP setup checklist (enable APIs, create the service account,
# share a SANDBOX COPY of the spreadsheet with the service-account email).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_PROJECT_ID=
SHEET_ID=
SHEET_TAB=Investors

# --- Runner behavior ---
BATCH_SIZE=5
CONFIDENCE_MIN=0.5

# --- Gmail draft creation (optional, off by default) ---
# Requires domain-wide delegation granted by a Workspace admin for the
# gmail.compose scope. Leave GMAIL_ENABLED=false until that's set up;
# the worker still writes Draft_Subject/Draft_Body to the sheet either way.
GMAIL_ENABLED=false
GMAIL_SENDER=ana.valentino@utilyze.ai

# --- Company context injected into prompts (never invent beyond this) ---
UTILYZE_CONTEXT_FILE=config/utilyze_context.md

LOG_LEVEL=INFO
